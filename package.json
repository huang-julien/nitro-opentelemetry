{
  "name": "nitro-opentelemetry",
  "version": "0.10.3",
  "description": "Opentelemetry module for the server framework nitro. Compatible with Nuxt.",
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "keywords": [
    "nitro",
    "opentelemetry",
    "nuxt",
    "nuxt-module",
    "nitro module"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./runtime/*": {
      "types": "./dist/runtime/*.d.ts",
      "import": "./dist/runtime/*",
      "require": "./dist/runtime/*"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "pnpm --filter=playground dev",
    "dev:build": "pnpm --filter=playground build",
    "dev:prepare": "pnpm build --stub && pnpm nitropack prepare && pnpm nitro prepare ./playground",
    "lint": "eslint .",
    "lint:fix": "automd && eslint . --fix",
    "prepack": "pnpm build",
    "release": "pnpm test && changelogen --release && pnpm publish && git push --follow-tags",
    "test": "pnpm lint && pnpm test:types && vitest run",
    "test:types": "tsc --noEmit --skipLibCheck"
  },
  "devDependencies": {
    "@azure/monitor-opentelemetry-exporter": "catalog:",
    "@microlabs/otel-cf-workers": "catalog:",
    "@nuxt/nitro-server": "catalog:",
    "@nuxt/schema": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "automd": "catalog:",
    "changelogen": "catalog:",
    "eslint": "catalog:",
    "eslint-config-unjs": "catalog:",
    "h3": "catalog:",
    "jiti": "catalog:",
    "nitro-opentelemetry": "link:./",
    "nitro-test-utils": "catalog:",
    "nitropack": "catalog:",
    "typescript": "catalog:",
    "unbuild": "catalog:",
    "unimport": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "@azure/monitor-opentelemetry": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/auto-instrumentations-node": "catalog:",
    "@opentelemetry/context-async-hooks": "catalog:",
    "@opentelemetry/instrumentation": "catalog:",
    "@opentelemetry/instrumentation-http": "catalog:",
    "@opentelemetry/instrumentation-undici": "catalog:",
    "@opentelemetry/resources": "catalog:",
    "@opentelemetry/sdk-metrics": "catalog:",
    "@opentelemetry/sdk-node": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@opentelemetry/sdk-trace-node": "catalog:",
    "@opentelemetry/semantic-conventions": "catalog:",
    "consola": "catalog:",
    "defu": "catalog:",
    "estree-walker": "catalog:",
    "exsolve": "catalog:",
    "magic-string": "catalog:",
    "mlly": "catalog:",
    "pathe": "catalog:",
    "rollup": "catalog:"
  },
  "peerDependencies": {
    "@microlabs/otel-cf-workers": "catalog:"
  }
}
